# Copy these names into your local or hosting environment. Never commit real values.

# Where the frontend sends its API calls, read at BUILD time by Vite.
#
# Set this on the frontend host (Vercel) to the Render service. The backend is
# deliberately stateful — sessions and execution runs live in process, see
# store.py — and one plan request runs six agents for the better part of a
# minute. Neither survives a serverless function: state is lost between
# invocations, so approving a plan 410s, and the request outlives the duration
# limit. Unset, the frontend falls back to same-origin /api.
VITE_API_BASE=https://tripshield-api.onrender.com/api


# Optional AI personalization. `openai_api_key` matches the Vercel and Render
# variable name for this project; the backend also accepts OPENAI_API_KEY for
# conventional local shells.
AI_PROVIDER=openai
openai_api_key=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_TIMEOUT_SECONDS=

# Free-tier AI. OpenAI has no free tier, but its wire protocol is spoken by
# providers that do, so point the same client at one of these and keep
# AI_PROVIDER=openai. Set the key variable above to that provider's key.
#
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai/
#                  free key at aistudio.google.com · OPENAI_MODEL=gemini-2.5-flash
#   Groq           https://api.groq.com/openai/v1  · free key at console.groq.com
#   OpenRouter     https://openrouter.ai/api/v1    · models suffixed `:free`
#   Ollama (local) http://localhost:11434/v1       · no key needed, no network
#
# Leave blank to talk to OpenAI itself. With nothing set at all the app is
# fail-closed and still returns every plan deterministically.
OPENAI_BASE_URL=

# Optional read-only travel integrations. Every one of these is free as
# configured: Duffel and LiteAPI run against their sandboxes, and activities,
# dining and ground are deterministic fixtures that make no call at all.
# AeroDataBox is the only live upstream — its RapidAPI free tier is metered, so
# leaving it unset keeps flight status on fixtures and costs nothing.
AERODATABOX_API_KEY=
DUFFEL_ACCESS_TOKEN=
LITEAPI_SANDBOX_KEY=
LITEAPI_HOTEL_IDS=
VIATOR_API_KEY=
