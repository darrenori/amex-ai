{
  "name": "amex-ai",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "TripShield — a Travel Recovery Orchestrator for American Express Card Members. AMEX AI Hackathon 2026 concept.",
  "scripts": {
    "dev": "vite",
    "dev:api": "uvicorn api.index:app --reload --port 8000",
